---
import '@/styles/global.css';
import SiteShell from '@/components/SiteShell';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// description 为空时回退到站点标题，避免出现空的 meta description
const metaDescription = description ?? (site.description || site.title);
const pageTitle = title
  ? `${title} · ${site.title}`
  : site.description
    ? `${site.title} · ${site.description}`
    : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      阻塞式主题脚本：必须在首帧之前执行，否则深色模式会闪白。
      不能用 Astro 的默认 <script>（它是异步的）。
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* localStorage 不可用时按浅色处理 */
        }
      })();
    </script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <!--
      整站外壳是单独一个 React 岛，因为 shadcn 的 Sidebar 依赖 Provider 的 context。
      页面内容作为 children 传入，仍在构建期渲染成静态 HTML。
    -->
    <SiteShell
      client:load
      nav={site.nav}
      currentPath={Astro.url.pathname}
      config={site}
    >
      <slot />
    </SiteShell>
  </body>
</html>
