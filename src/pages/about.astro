---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBreadcrumb from '@/components/PageBreadcrumb.astro';
import { Separator } from '@/components/ui/separator';
import { site } from '@/data/site';

const hasBio = site.bio.length > 0;
---

<BaseLayout title="关于">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <PageBreadcrumb
      items={[{ label: '首页', href: '/' }, { label: '关于' }]}
    />

    <h1 class="font-heading text-3xl font-semibold tracking-tight">
      {site.author}
    </h1>

    {
      hasBio && (
        <div class="mt-8 flex flex-col gap-5 leading-relaxed text-pretty">
          {site.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )
    }

    <Separator className="my-10" />

    <h2 class="font-heading text-lg font-medium">联系我</h2>
    <ul class="mt-4 flex flex-col gap-2 text-sm">
      {
        site.email && (
          <li>
            <span class="text-muted-foreground">邮箱：</span>
            <a href={`mailto:${site.email}`} class="hover:underline">
              {site.email}
            </a>
          </li>
        )
      }
      {
        site.social.map((link) => (
          <li>
            <span class="text-muted-foreground">{link.label}：</span>
            <a href={link.href} class="hover:underline" rel="noopener">
              {link.href}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
