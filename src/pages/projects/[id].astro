---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBreadcrumb from '@/components/PageBreadcrumb.astro';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { buttonVariants } from '@/components/ui/button';
import { formatDate } from '@/lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, pubDate, tech, tags, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <PageBreadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: '作品', href: '/projects' },
        { label: title },
      ]}
    />

    <h1
      class="font-heading text-3xl font-semibold tracking-tight text-balance"
    >
      {title}
    </h1>

    <p class="mt-3 text-lg text-muted-foreground text-pretty">{description}</p>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <time class="text-muted-foreground" datetime={pubDate.toISOString()}>
        {formatDate(pubDate)}
      </time>
      {
        tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`}>
            <Badge variant="ghost">{tag}</Badge>
          </a>
        ))
      }
    </div>

    {
      tech.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tech.map((item) => (
            <Badge variant="outline">{item}</Badge>
          ))}
        </div>
      )
    }

    {
      (repo || demo) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {repo && (
            <a
              href={repo}
              rel="noopener"
              class={buttonVariants({ variant: 'outline', size: 'sm' })}
            >
              查看代码
            </a>
          )}
          {demo && (
            <a
              href={demo}
              rel="noopener"
              class={buttonVariants({ variant: 'outline', size: 'sm' })}
            >
              在线演示
            </a>
          )}
        </div>
      )
    }

    <Separator className="my-10" />

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
