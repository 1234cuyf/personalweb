---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBreadcrumb from '@/components/PageBreadcrumb.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from '@/components/ui/empty';
import { FolderIcon } from 'lucide-react';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
---

<BaseLayout title="作品" description="我做过的一些项目">
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <PageBreadcrumb items={[{ label: '首页', href: '/' }, { label: '作品' }]} />

    <h1 class="font-heading text-3xl font-semibold tracking-tight">作品</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground text-pretty">
      {projects.length > 0
        ? `共 ${projects.length} 个项目。`
        : '我做过的一些项目。'}
    </p>

    {
      projects.length === 0 ? (
        <div class="mt-10">
          <Empty>
            <EmptyMedia variant="icon">
              <FolderIcon />
            </EmptyMedia>
            <EmptyHeader>
              <EmptyTitle>还没有作品</EmptyTitle>
              <EmptyDescription>
                {
                  import.meta.env.DEV ? (
                    '往 src/content/projects/ 里添加一个 Markdown 文件就会出现在这里。'
                  ) : (
                    <>
                      项目还在整理中。可以先 <a href="/blog">看看文章</a>，或者
                      <a href="/resume">看我的简历</a>。
                    </>
                  )
                }
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        </div>
      ) : (
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
