---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBreadcrumb from '@/components/PageBreadcrumb.astro';
import ResumeExperience from '@/components/ResumeExperience';
import ResumeSkills from '@/components/ResumeSkills';
import { Separator } from '@/components/ui/separator';
import { resume } from '@/data/resume';

// 每个板块为空时整块隐藏，不留下空标题
const hasSummary = resume.summary.length > 0;
const hasContact = resume.contact.length > 0;
const hasExperience = resume.experience.length > 0;
const hasEducation = resume.education.length > 0;
const hasSkills = resume.skills.length > 0;

const description = resume.headline
  ? `${resume.name} · ${resume.headline}`
  : resume.name;
---

<BaseLayout title="简历" description={description}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <PageBreadcrumb
      items={[{ label: '首页', href: '/' }, { label: '简历' }]}
    />

    <header
      class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
    >
      <div>
        <h1 class="font-heading text-3xl font-semibold tracking-tight">
          {resume.name}
        </h1>
        {
          resume.headline && (
            <p class="mt-1 text-muted-foreground">{resume.headline}</p>
          )
        }
      </div>
      <button
        type="button"
        class="no-print inline-flex h-9 w-fit items-center rounded-lg border border-border bg-background px-3 text-sm font-medium transition-colors hover:bg-muted"
        onclick="window.print()"
      >
        打印 / 导出 PDF
      </button>
    </header>

    {
      hasSummary && (
        <p class="mt-6 leading-relaxed text-pretty">{resume.summary}</p>
      )
    }

    {
      hasContact && (
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {resume.contact.map((item) => (
            <li class="text-muted-foreground">
              <span class="text-foreground">{item.label}：</span>
              {item.href ? (
                <a href={item.href} class="hover:underline">
                  {item.value}
                </a>
              ) : (
                item.value
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      hasExperience && (
        <>
          <Separator className="my-10" />
          <section>
            <h2 class="font-heading text-xl font-semibold tracking-tight">
              工作经历
            </h2>
            {/* Accordion 需要交互，所以这个岛是 client:load（嵌在 SiteShell 岛内部） */}
            <div class="mt-4">
              <ResumeExperience client:load items={resume.experience} />
            </div>
          </section>
        </>
      )
    }

    {
      hasEducation && (
        <>
          <Separator className="my-10" />
          <section>
            <h2 class="font-heading text-xl font-semibold tracking-tight">
              教育经历
            </h2>
            <div class="mt-6 flex flex-col gap-4">
              {resume.education.map((edu) => (
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <div>
                    <p class="font-medium">{edu.school}</p>
                    <p class="text-sm text-muted-foreground">{edu.degree}</p>
                    {edu.highlights && edu.highlights.length > 0 && (
                      <p class="mt-1 text-sm text-muted-foreground">
                        {edu.highlights.join(' · ')}
                      </p>
                    )}
                  </div>
                  <p class="text-sm text-muted-foreground">{edu.period}</p>
                </div>
              ))}
            </div>
          </section>
        </>
      )
    }

    {
      hasSkills && (
        <>
          <Separator className="my-10" />
          <section>
            <h2 class="font-heading text-xl font-semibold tracking-tight">
              技能
            </h2>
            <div class="mt-6">
              <ResumeSkills groups={resume.skills} />
            </div>
          </section>
        </>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  @media print {
    header,
    footer,
    .no-print {
      display: none !important;
    }

    html,
    body {
      background: #fff !important;
      color: #000 !important;
    }

    @page {
      margin: 16mm;
    }
  }
</style>
